<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Read only, and for one decision: whether the connection is somebody's
        data allowance. Pictures wait for Wi-Fi by default; the boards
        themselves are text and go regardless.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".TierYourLifeApplication"
        tools:targetApi="33"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TierYourLife">
        <!--
            No screenOrientation, and nothing in code asking for one either. A
            phone was held upright for a while on the argument that a board is a
            column of rows and turning it only cuts the rows short. That is a
            reason to prefer upright, not a reason to refuse sideways: whoever
            is holding the phone can see the screen, and the app taking the
            decision away is the part they notice.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="locale|layoutDirection|screenLayout"
            android:exported="true"
            android:theme="@style/Theme.TierYourLife"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
