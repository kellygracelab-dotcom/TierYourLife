<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The colour the system paints into the window before Compose draws into it, so
         these must agree with what Compose is about to draw: SurfaceLight and
         SurfaceDark in core/theme.

         window_background follows the system's night setting through values-night and is
         used when the app's own theme choice is "follow system". The two explicit ones
         are for when the user has overridden that in Settings — see
         MainActivity.applyWindowBackground. -->
    <color name="window_background_light">#FBF8FF</color>
    <color name="window_background_dark">#121318</color>
    <color name="window_background">@color/window_background_light</color>
</resources>
